{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate --schema=apps/api/prisma/schema.prisma && node scripts/prepare-vercel.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "{apps/api/**,node_modules/.prisma/**,node_modules/@prisma/client/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1", "destination": "/api" },
    { "source": "/api/v1/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/bookings", "destination": "/admin/bookings.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/menu", "destination": "/admin/menu.html" },
    { "source": "/book", "destination": "/book.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" }
  ]
}
